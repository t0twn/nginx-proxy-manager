#!/command/with-contenv bash
# shellcheck shell=bash

set -e
. /usr/bin/configure-hosts-resolver.sh

# Upstream prepare has already generated its resolver and set file ownership.
# Configure only our generated resolver; leave upstream scripts untouched.
configure_hosts_resolver

if ! hosts_resolver_is_true "${ENABLE_HOSTS_RESOLVER:-}"; then
	# Keep the optional service ready without running a DNS server.
	printf '\n' >&3
	exec sleep infinity
fi

PUID=${PUID:-0}
PGID=${PGID:-0}
if [ "$PUID" != '0' ] && [ "$PGID" = '0' ]; then
	PGID=$PUID
fi

echo 'Starting hosts resolver on 127.0.0.1:5353 ...'
exec /command/s6-notifyoncheck -d -3 3 -n 0 -T 25000 -t 1000 -w 100 \
	/command/s6-setuidgid "$PUID:$PGID" bash /usr/bin/run-hosts-dns.sh
