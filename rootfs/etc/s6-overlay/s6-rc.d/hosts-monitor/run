#!/command/with-contenv bash
# shellcheck shell=bash
set -e
. /usr/bin/configure-hosts-resolver.sh

if ! hosts_resolver_is_true "${ENABLE_HOSTS_RESOLVER:-}"; then
	printf '\n' >&3
	exec sleep infinity
fi

# Keep control of the root-owned s6 service FIFO. dnsmasq itself uses PUID/PGID.
exec bash /usr/bin/hosts-monitor.sh
